# MyMeshy local config — copy to `.env` and adjust. Loaded by the backend
# (see backend/app/config.py). All values are optional; the app runs without it.

# Hardware profile. `auto` detects known GPUs. The AssetForge fork recognizes
# an RTX 3060 with ~12GB VRAM and enables the rtx3060_12gb scheduling policy.
MYMESHY_HARDWARE_PROFILE=auto

# Optional hard cap on torch CUDA allocations, in GB. Leave 0 for normal use.
# Stage isolation is independent of this cap, so a 12GB card can use most of
# its VRAM without keeping multiple heavyweight models resident at once.
MYMESHY_VRAM_BUDGET_GB=0

# Optional override. When unset, the hardware profile decides whether each
# heavyweight model is unloaded after its pipeline stage.
# MYMESHY_FORCE_STAGE_UNLOAD=true

# Heavy GPU model isolation. On the RTX 3060 12GB profile this defaults to true.
# Run scripts\setup-workers.ps1 to create the worker environments below.
# Shape and Paint are separate *processes* even when they share the Hunyuan venv.
# MYMESHY_ISOLATED_WORKERS=true
# MYMESHY_TRIPOSR_WORKER_PYTHON=.workers\triposr\Scripts\python.exe
# MYMESHY_HUNYUAN_SHAPE_WORKER_PYTHON=.workers\hunyuan\Scripts\python.exe
# MYMESHY_HUNYUAN_PAINT_WORKER_PYTHON=.workers\hunyuan\Scripts\python.exe
# MYMESHY_WORKER_TIMEOUT_SEC=1800

# Adapter selection. `auto` is hardware-aware in the AssetForge fork and falls
# back to mock so the app always runs.
MYMESHY_I23D_ADAPTER=auto      # trellis | hunyuan3d | triposr | mock | auto
MYMESHY_T2I_ADAPTER=auto       # sdxl_turbo | mock | auto
MYMESHY_TEXTURE_ADAPTER=auto   # hunyuan_paint | mock | auto

# Use the full Hunyuan3D-2 shape model instead of the lighter 2mini default.
# MYMESHY_HUNYUAN_SHAPE_MODEL=tencent/Hunyuan3D-2
# MYMESHY_HUNYUAN_PAINT_MODEL=tencent/Hunyuan3D-2

# Path to Blender (for FBX export). Only needed if auto-detection misses it;
# Steam and standard installs are found automatically.
# MYMESHY_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
