# MyMeshy / AssetForge local config — copy to `.env` and adjust.
# Loaded by backend/app/config.py. All values are optional.

# Hardware scheduling profile. `auto` detects an RTX 3060 12GB and applies the
# reference profile automatically. You can force it with rtx3060_12gb.
MYMESHY_HARDWARE_PROFILE=auto

# Hard cap on torch CUDA allocations, in GB. Keep this at 0 for the normal
# RTX 3060 profile: the scheduler will isolate heavy stages while allowing each
# stage to use the card's available VRAM. Use a numeric cap only when you want
# to reserve VRAM for other applications.
MYMESHY_VRAM_BUDGET_GB=0

# Optional override for heavy-model lifetime. By default the RTX 3060 profile
# unloads each heavy model before the next stage to avoid VRAM overlap.
# MYMESHY_FORCE_STAGE_UNLOAD=true

# Adapter selection. `auto` is hardware-aware. On the RTX 3060 12GB it prefers
# Hunyuan3D-2mini, then TripoSR, then legacy TRELLIS, then mock.
MYMESHY_I23D_ADAPTER=auto      # trellis | hunyuan3d | triposr | mock | auto
MYMESHY_T2I_ADAPTER=auto       # sdxl_turbo | mock | auto
MYMESHY_TEXTURE_ADAPTER=auto   # hunyuan_paint | mock | auto

# Use the full Hunyuan3D-2 shape model instead of the lighter 2mini default.
# Not recommended for the RTX 3060 reference profile until benchmarked.
# MYMESHY_HUNYUAN_SHAPE_MODEL=tencent/Hunyuan3D-2

# Path to Blender (for FBX export). Only needed if auto-detection misses it;
# Steam and standard installs are found automatically.
# MYMESHY_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
